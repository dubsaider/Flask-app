# Скопируйте в .env и измените значения при необходимости.
# .env не попадает в git (см. .gitignore).

# development | production | testing
FLASK_CONFIG=development

# true | false
FLASK_DEBUG=true

FLASK_HOST=127.0.0.1
FLASK_PORT=5000

SECRET_KEY=dev-secret-change-in-production

# Пути к SQLite (по умолчанию — корень проекта)
# DATABASE_PATH=kanban.db

# Применять миграции при старте приложения (true | false)
# AUTO_MIGRATE=true

# Если БД уже была создана до Flask-Migrate, один раз выполните:
# flask --app app:create_app db stamp head

# Лимиты rich-text
# MAX_HTML_LENGTH=50000
# MAX_IMAGE_DATA_URL_LENGTH=700000
# RICH_TEXT_MAX_IMAGE_SIZE=512000
